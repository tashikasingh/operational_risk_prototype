# Email notification configuration for the approval workflow.
# Copy this file to ".env" (same folder) and fill in your real values.
# NEVER commit the real ".env" file to git -- only this .env.example template.

# The Gmail account that will SEND the notification (e.g. your own address)
EMAIL_ADDRESS=your gmail address here

# A Gmail APP PASSWORD (16 characters, no spaces) -- NOT your normal Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the Google account first)
EMAIL_APP_PASSWORD=your gmail app password here

# The address that RECEIVES approval notifications (the "senior risk officer").
# For a demo/prototype, this can be the same as EMAIL_ADDRESS above (send to yourself).
APPROVER_EMAIL=approver's gmail address here